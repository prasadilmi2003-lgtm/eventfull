# false (default) = call the real Express API (Vite proxies /api to http://localhost:5000 in dev).
# true = use the built-in mock server (data kept in the browser). Works with no backend.
VITE_USE_MOCK=false

# Production only: the deployed API origin, e.g. https://api.example.com (leave empty in dev).
VITE_API_URL=
