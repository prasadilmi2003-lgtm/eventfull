# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/eventease
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/eventease?retryWrites=true&w=majority

# JWT Secret for signing session cookies (use a long, unguessable string in production)
JWT_SECRET=your_super_secret_and_long_jwt_signing_key_here

# Frontend Application URL (used for CORS and password reset links)
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development
